# Address of the auth server. On a physical phone, use this computer's LAN IP
# instead of localhost, for example http://192.168.1.20:8787
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787

# Photon project credentials.
PROJECT_ID=
PROJECT_SECRET=

# Used only to hash login codes.
CODE_PEPPER=
PORT=8787

# Tavily API key from https://app.tavily.com — finds Reddit and blog mentions.
TAVILY_API_KEY=

# Google Places API (New). Confirms a spot has fewer than 100 reviews.
GOOGLE_PLACES_API_KEY=
