{
  "name": "linkup-demo",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "server": "node --env-file=.env --import tsx server/index.ts",
    "setup": "node scripts/setup.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint .",
    "reset-demo": "node scripts/reset.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.0",
    "expo": "^57.0.25",
    "expo-font": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "spectrum-ts": "12.10.1",
    "expo-constants": "~57.0.19",
    "react-native-safe-area-context": "~5.7.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "react-dom": "19.2.3",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3",
    "tsx": "^4.20.5",
    "@types/node": "^22",
    "eslint": "^9",
    "typescript-eslint": "^8"
  },
  "engines": {
    "node": "^22.13.0 || >=24.3.0"
  }
}
